# Copy to .env for local development: cp .env.example .env
# Local placeholders only. Never commit real credentials to this repository.

# API server
API_PORT=3001

# Local PostgreSQL from docker-compose.yml. Port 5433 avoids clashing with any
# PostgreSQL already installed on the host.
DATABASE_URL=postgresql://cartoptix:local_dev_password@localhost:5433/cartoptix
