# Registry that holds the published release images.
# CI publishes to it; the development host pulls from it.
IMAGE_REGISTRY=<account-id>.dkr.ecr.ap-southeast-1.amazonaws.com

# The Git commit SHA of the release to run.
# release.sh sets this from its argument, so this value is only used when you
# run docker compose directly.
RELEASE=replace_with_the_release_commit_sha

POSTGRES_DB=cartoptix
POSTGRES_USER=cartoptix
POSTGRES_PASSWORD=replace_with_a_strong_password

# Optional. Host port the web container is published on. Defaults to 80.
# Only set this when port 80 is already in use, which happens on development
# machines. release.sh probes readiness on the same port.
# WEB_PORT=8080
