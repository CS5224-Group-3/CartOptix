  "scenarios": [
    {
      "name": "pays the delivery fee below the free-delivery threshold",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "milk",
          "packs": 10
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 3200,
        "measuredAmount": 3200,
        "delivery": {
          "amount": 599,
          "free": false
        },
        "orderCharges": [],
        "total": 3799,
        "disclosureCodes": []
      }
    },
    {
      "name": "refuses an order below the retailer's minimum and reports the shortfall",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "milk",
          "packs": 5
        }
      ],
      "expect": {
        "status": "infeasible",
        "code": "minimum-order-not-met",
        "minimumOrder": 2000,
        "measuredAmount": 1600,
        "shortfall": 400
      }
    },
    {
      "name": "accepts an order exactly at the retailer's minimum",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "bread",
          "packs": 4
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 2000,
        "measuredAmount": 2000,
        "delivery": {
          "amount": 599,
          "free": false
        },
        "orderCharges": [],
        "total": 2599,
        "disclosureCodes": []
      }
    },
    {
      "name": "still pays delivery one cent below the free-delivery threshold",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "bread",
          "packs": 11
        },
        {
          "offer": "butter",
          "packs": 1
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 5998,
        "measuredAmount": 5998,
        "delivery": {
          "amount": 599,
          "free": false
        },
        "orderCharges": [],
        "total": 6597,
        "disclosureCodes": []
      }
    },
    {
      "name": "gives free delivery exactly at the free-delivery threshold",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "bread",
          "packs": 11
        },
        {
          "offer": "egg",
          "packs": 1
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 5999,
        "measuredAmount": 5999,
        "delivery": {
          "amount": 0,
          "free": true
        },
        "orderCharges": [],
        "total": 5999,
        "disclosureCodes": []
      }
    },
    {
      "name": "gives free delivery above the free-delivery threshold",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "bread",
          "packs": 12
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 6000,
        "measuredAmount": 6000,
        "delivery": {
          "amount": 0,
          "free": true
        },
        "orderCharges": [],
        "total": 6000,
        "disclosureCodes": []
      }
    },
    {
      "name": "leaves charges out of the threshold when the retailer excludes them",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "soda",
          "packs": 3
        },
        {
          "offer": "milk",
          "packs": 10
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 3800,
        "measuredAmount": 3740,
        "delivery": {
          "amount": 599,
          "free": false
        },
        "orderCharges": [],
        "total": 4399,
        "disclosureCodes": []
      }
    },
    {
      "name": "counts charges toward the threshold when the retailer includes them",
      "retailer": "beta",
      "lines": [
        {
          "offer": "betaMilk",
          "packs": 5
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 1500,
        "measuredAmount": 1500,
        "delivery": {
          "amount": 350,
          "free": false
        },
        "orderCharges": [
          {
            "label": "Packaging fee",
            "amount": 50,
            "waivedFrom": null,
            "waived": false
          }
        ],
        "total": 1900,
        "disclosureCodes": []
      }
    },
    {
      "name": "reports one disclosure when several lines raise the same notice",
      "retailer": "alpha",
      "lines": [
        {
          "offer": "water",
          "packs": 2
        },
        {
          "offer": "sparkling",
          "packs": 2
        },
        {
          "offer": "milk",
          "packs": 10
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 3820,
        "measuredAmount": 3820,
        "delivery": {
          "amount": 599,
          "free": false
        },
        "orderCharges": [],
        "total": 4419,
        "disclosureCodes": ["charge-included-in-price"]
      }
    },
    {
      "name": "blocks the total when the delivery rule is unverified",
      "retailer": "gamma",
      "lines": [
        {
          "offer": "gammaMilk",
          "packs": 5
        }
      ],
      "expect": {
        "status": "unavailable",
        "code": "delivery-rule-unverified"
      }
    },
    {
      "name": "blocks the total when the delivery fee is unresolved",
      "retailer": "delta",
      "lines": [
        {
          "offer": "deltaMilk",
          "packs": 5
        }
      ],
      "expect": {
        "status": "unavailable",
        "code": "delivery-rule-unverified"
      }
    },
    {
      "name": "blocks the total when an order-level charge is unresolved",
      "retailer": "epsilon",
      "lines": [
        {
          "offer": "epsilonMilk",
          "packs": 5
        }
      ],
      "expect": {
        "status": "unavailable",
        "code": "charge-unresolved"
      }
    },
    {
      "name": "gives free delivery at the threshold even when the fee is unresolved",
      "retailer": "zeta",
      "lines": [
        {
          "offer": "zetaMilk",
          "packs": 10
        }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 3000,
        "measuredAmount": 3000,
        "delivery": {
          "amount": 0,
          "free": true
        },
        "orderCharges": [],
        "total": 3000,
        "disclosureCodes": []
      }
    },
    {
      "name": "blocks the total below the threshold when the fee is unresolved",
      "retailer": "zeta",
      "lines": [
        {
          "offer": "zetaMilk",
          "packs": 9
        }
      ],
      "expect": {
        "status": "unavailable",
        "code": "delivery-rule-unverified"
      }
    }
  ]
}
