{
  "_comment": [
    "Retailer-order scenarios for the shared pricing module (issue #8).",
    "Every expected amount is hand-calculated in integer SGD cents.",
    "alpha's free-delivery threshold is 5999 so the boundary can be probed at",
    "5998, 5999 and 6000 using whole packs of real-looking prices.",
    "Retailer rules here are invented for testing; the verified Singapore",
    "delivery scenarios belong to curation (issue #4, PR-04)."
  ],
  "datasetId": "pricing-fixture-v1",

  "retailers": {
    "alpha": {
      "retailerId": "alpha",
      "datasetId": "pricing-fixture-v1",
      "verified": true,
      "fee": 599,
      "freeDeliveryThreshold": 5999,
      "minimumOrder": 2000,
      "thresholdBasis": { "amount": "paid", "includesMandatoryCharges": false },
      "orderCharges": []
    },
    "beta": {
      "retailerId": "beta",
      "datasetId": "pricing-fixture-v1",
      "verified": true,
      "fee": 350,
      "freeDeliveryThreshold": null,
      "minimumOrder": null,
      "thresholdBasis": { "amount": "paid", "includesMandatoryCharges": true },
      "orderCharges": [{ "label": "Packaging fee", "amount": 50, "includedInPrice": false }]
    },
    "gamma": {
      "retailerId": "gamma",
      "datasetId": "pricing-fixture-v1",
      "verified": false,
      "fee": 400,
      "freeDeliveryThreshold": 5000,
      "minimumOrder": null,
      "thresholdBasis": { "amount": "paid", "includesMandatoryCharges": false },
      "orderCharges": []
    },
    "delta": {
      "retailerId": "delta",
      "datasetId": "pricing-fixture-v1",
      "verified": true,
      "fee": null,
      "freeDeliveryThreshold": null,
      "minimumOrder": null,
      "thresholdBasis": { "amount": "paid", "includesMandatoryCharges": false },
      "orderCharges": []
    },
    "epsilon": {
      "retailerId": "epsilon",
      "datasetId": "pricing-fixture-v1",
      "verified": true,
      "fee": 500,
      "freeDeliveryThreshold": null,
      "minimumOrder": null,
      "thresholdBasis": { "amount": "paid", "includesMandatoryCharges": false },
      "orderCharges": [{ "label": "Bag levy", "amount": null, "includedInPrice": false }]
    }
  },

  "offers": {
    "bread": {
      "listingId": "alpha-bread",
      "productId": "bread-400g",
      "retailerId": "alpha",
      "unitPrice": 500,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "butter": {
      "listingId": "alpha-butter",
      "productId": "butter-250g",
      "retailerId": "alpha",
      "unitPrice": 498,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "egg": {
      "listingId": "alpha-egg",
      "productId": "eggs-10pack",
      "retailerId": "alpha",
      "unitPrice": 499,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "milk": {
      "listingId": "alpha-milk",
      "productId": "milk-1l",
      "retailerId": "alpha",
      "unitPrice": 320,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "soda": {
      "listingId": "alpha-soda",
      "productId": "soda-330ml-6pack",
      "retailerId": "alpha",
      "unitPrice": 180,
      "eligible": true,
      "charges": [
        { "label": "Beverage container deposit", "amount": 20, "includedInPrice": false }
      ],
      "excludedPromotions": []
    },
    "water": {
      "listingId": "alpha-water",
      "productId": "water-1-5l",
      "retailerId": "alpha",
      "unitPrice": 150,
      "eligible": true,
      "charges": [{ "label": "Beverage container deposit", "amount": 10, "includedInPrice": true }],
      "excludedPromotions": []
    },
    "sparkling": {
      "listingId": "alpha-sparkling",
      "productId": "sparkling-water-1l",
      "retailerId": "alpha",
      "unitPrice": 160,
      "eligible": true,
      "charges": [{ "label": "Beverage container deposit", "amount": 10, "includedInPrice": true }],
      "excludedPromotions": []
    },
    "betaMilk": {
      "listingId": "beta-milk",
      "productId": "milk-1l",
      "retailerId": "beta",
      "unitPrice": 300,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "gammaMilk": {
      "listingId": "gamma-milk",
      "productId": "milk-1l",
      "retailerId": "gamma",
      "unitPrice": 300,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "deltaMilk": {
      "listingId": "delta-milk",
      "productId": "milk-1l",
      "retailerId": "delta",
      "unitPrice": 300,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    },
    "epsilonMilk": {
      "listingId": "epsilon-milk",
      "productId": "milk-1l",
      "retailerId": "epsilon",
      "unitPrice": 300,
      "eligible": true,
      "charges": [],
      "excludedPromotions": []
    }
  },

  "scenarios": [
    {
      "name": "pays the delivery fee below the free-delivery threshold",
      "retailer": "alpha",
      "lines": [{ "offer": "milk", "packs": 10 }],
      "expect": {
        "status": "priced",
        "itemsTotal": 3200,
        "measuredAmount": 3200,
        "delivery": { "amount": 599, "free": false },
        "appliedCharges": [],
        "total": 3799,
        "disclosureCodes": []
      }
    },
    {
      "name": "refuses an order below the retailer's minimum and reports the shortfall",
      "retailer": "alpha",
      "lines": [{ "offer": "milk", "packs": 5 }],
      "expect": { "status": "infeasible", "code": "minimum-order-not-met", "shortfall": 400 }
    },
    {
      "name": "still pays delivery one cent below the free-delivery threshold",
      "retailer": "alpha",
      "lines": [{ "offer": "bread", "packs": 11 }, { "offer": "butter", "packs": 1 }],
      "expect": {
        "status": "priced",
        "itemsTotal": 5998,
        "measuredAmount": 5998,
        "delivery": { "amount": 599, "free": false },
        "appliedCharges": [],
        "total": 6597,
        "disclosureCodes": []
      }
    },
    {
      "name": "gives free delivery exactly at the free-delivery threshold",
      "retailer": "alpha",
      "lines": [{ "offer": "bread", "packs": 11 }, { "offer": "egg", "packs": 1 }],
      "expect": {
        "status": "priced",
        "itemsTotal": 5999,
        "measuredAmount": 5999,
        "delivery": { "amount": 0, "free": true },
        "appliedCharges": [],
        "total": 5999,
        "disclosureCodes": []
      }
    },
    {
      "name": "gives free delivery above the free-delivery threshold",
      "retailer": "alpha",
      "lines": [{ "offer": "bread", "packs": 12 }],
      "expect": {
        "status": "priced",
        "itemsTotal": 6000,
        "measuredAmount": 6000,
        "delivery": { "amount": 0, "free": true },
        "appliedCharges": [],
        "total": 6000,
        "disclosureCodes": []
      }
    },
    {
      "name": "leaves charges out of the threshold when the retailer excludes them",
      "retailer": "alpha",
      "lines": [{ "offer": "soda", "packs": 3 }, { "offer": "milk", "packs": 10 }],
      "expect": {
        "status": "priced",
        "itemsTotal": 3800,
        "measuredAmount": 3740,
        "delivery": { "amount": 599, "free": false },
        "appliedCharges": [],
        "total": 4399,
        "disclosureCodes": []
      }
    },
    {
      "name": "counts charges toward the threshold when the retailer includes them",
      "retailer": "beta",
      "lines": [{ "offer": "betaMilk", "packs": 5 }],
      "expect": {
        "status": "priced",
        "itemsTotal": 1500,
        "measuredAmount": 1500,
        "delivery": { "amount": 350, "free": false },
        "appliedCharges": [{ "label": "Packaging fee", "perPack": null, "amount": 50 }],
        "total": 1900,
        "disclosureCodes": []
      }
    },
    {
      "name": "reports one disclosure when several lines raise the same notice",
      "retailer": "alpha",
      "lines": [
        { "offer": "water", "packs": 2 },
        { "offer": "sparkling", "packs": 2 },
        { "offer": "milk", "packs": 10 }
      ],
      "expect": {
        "status": "priced",
        "itemsTotal": 3820,
        "measuredAmount": 3820,
        "delivery": { "amount": 599, "free": false },
        "appliedCharges": [],
        "total": 4419,
        "disclosureCodes": ["charge-included-in-price"]
      }
    },
    {
      "name": "blocks the total when the delivery rule is unverified",
      "retailer": "gamma",
      "lines": [{ "offer": "gammaMilk", "packs": 5 }],
      "expect": { "status": "unavailable", "code": "delivery-rule-unverified" }
    },
    {
      "name": "blocks the total when the delivery fee is unresolved",
      "retailer": "delta",
      "lines": [{ "offer": "deltaMilk", "packs": 5 }],
      "expect": { "status": "unavailable", "code": "delivery-rule-unverified" }
    },
    {
      "name": "blocks the total when an order-level charge is unresolved",
      "retailer": "epsilon",
      "lines": [{ "offer": "epsilonMilk", "packs": 5 }],
      "expect": { "status": "unavailable", "code": "charge-unresolved" }
    },
    {
      "name": "rejects a line belonging to a different retailer",
      "retailer": "alpha",
      "lines": [{ "offer": "betaMilk", "packs": 5 }],
      "expect": { "status": "unavailable", "code": "invalid-request" }
    },
    {
      "name": "rejects an order with no lines",
      "retailer": "alpha",
      "lines": [],
      "expect": { "status": "unavailable", "code": "invalid-request" }
    }
  ]
}
