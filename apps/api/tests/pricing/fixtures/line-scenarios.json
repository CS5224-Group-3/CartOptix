  "scenarios": [
    {
      "name": "prices whole packs at the verified per-pack price",
      "offer": "milk",
      "packs": 3,
      "expect": {
        "status": "priced",
        "packsSubtotal": 960,
        "total": 960,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 3,
            "unitPrice": 320,
            "amount": 960
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": null
      }
    },
    {
      "name": "prices a single pack",
      "offer": "milk",
      "packs": 1,
      "expect": {
        "status": "priced",
        "packsSubtotal": 320,
        "total": 320,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 1,
            "unitPrice": 320,
            "amount": 320
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": null
      }
    },
    {
      "name": "prices the largest supported quantity",
      "offer": "milk",
      "packs": 20,
      "expect": {
        "status": "priced",
        "packsSubtotal": 6400,
        "total": 6400,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 20,
            "unitPrice": 320,
            "amount": 6400
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": null
      }
    },
    {
      "name": "adds a deposit the price excludes, once for every pack",
      "offer": "soda",
      "packs": 4,
      "expect": {
        "status": "priced",
        "packsSubtotal": 720,
        "total": 800,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 4,
            "unitPrice": 180,
            "amount": 720
          }
        ],
        "appliedCharges": [
          {
            "label": "Beverage container deposit",
            "perPack": 20,
            "amount": 80
          }
        ],
        "disclosureCodes": [],
        "multibuy": null
      }
    },
    {
      "name": "discloses a deposit already inside the price without adding it again",
      "offer": "water",
      "packs": 4,
      "expect": {
        "status": "priced",
        "packsSubtotal": 600,
        "total": 600,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 4,
            "unitPrice": 150,
            "amount": 600
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": ["charge-included-in-price"],
        "multibuy": null
      }
    },
    {
      "name": "refuses to price a line whose mandatory charge is unresolved",
      "offer": "mystery",
      "packs": 1,
      "expect": {
        "status": "unavailable",
        "code": "charge-unresolved"
      }
    },
    {
      "name": "discloses an advertised promotion that curation did not verify",
      "offer": "rice",
      "packs": 2,
      "expect": {
        "status": "priced",
        "packsSubtotal": 2500,
        "total": 2500,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 2,
            "unitPrice": 1250,
            "amount": 2500
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": ["promotion-excluded"],
        "multibuy": null
      }
    },
    {
      "name": "refuses an offer curation excluded",
      "offer": "withdrawn",
      "packs": 1,
      "expect": {
        "status": "unavailable",
        "code": "offer-ineligible"
      }
    },
    {
      "name": "refuses an offer with no positive price",
      "offer": "zeroPriced",
      "packs": 1,
      "expect": {
        "status": "unavailable",
        "code": "offer-ineligible"
      }
    },
    {
      "name": "a multibuy below its pack count charges the unit price and reports no deal",
      "offer": "chicken",
      "packs": 1,
      "expect": {
        "status": "priced",
        "packsSubtotal": 350,
        "total": 350,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 1,
            "unitPrice": 350,
            "amount": 350
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": {
          "packsPerDeal": 2,
          "dealPrice": 655,
          "mixAndMatch": true,
          "percentOff": null,
          "deals": 0,
          "saving": 0
        }
      }
    },
    {
      "name": "an exact multibuy charges the deal price",
      "offer": "chicken",
      "packs": 2,
      "expect": {
        "status": "priced",
        "packsSubtotal": 655,
        "total": 655,
        "packsBreakdown": [
          {
            "kind": "multibuy",
            "deals": 1,
            "packsPerDeal": 2,
            "dealPrice": 655,
            "amount": 655
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": {
          "packsPerDeal": 2,
          "dealPrice": 655,
          "mixAndMatch": true,
          "percentOff": null,
          "deals": 1,
          "saving": 45
        }
      }
    },
    {
      "name": "packs left over after a multibuy are charged at the unit price",
      "offer": "chicken",
      "packs": 3,
      "expect": {
        "status": "priced",
        "packsSubtotal": 1005,
        "total": 1005,
        "packsBreakdown": [
          {
            "kind": "multibuy",
            "deals": 1,
            "packsPerDeal": 2,
            "dealPrice": 655,
            "amount": 655
          },
          {
            "kind": "unit",
            "packs": 1,
            "unitPrice": 350,
            "amount": 350
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": {
          "packsPerDeal": 2,
          "dealPrice": 655,
          "mixAndMatch": true,
          "percentOff": null,
          "deals": 1,
          "saving": 45
        }
      }
    },
    {
      "name": "a multibuy repeats across the maximum quantity",
      "offer": "chicken",
      "packs": 20,
      "expect": {
        "status": "priced",
        "packsSubtotal": 6550,
        "total": 6550,
        "packsBreakdown": [
          {
            "kind": "multibuy",
            "deals": 10,
            "packsPerDeal": 2,
            "dealPrice": 655,
            "amount": 6550
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": {
          "packsPerDeal": 2,
          "dealPrice": 655,
          "mixAndMatch": true,
          "percentOff": null,
          "deals": 10,
          "saving": 450
        }
      }
    },
    {
      "name": "a multibuy repeats with a remainder and still adds per-pack charges",
      "offer": "pasta",
      "packs": 7,
      "expect": {
        "status": "priced",
        "packsSubtotal": 2145,
        "total": 2215,
        "packsBreakdown": [
          {
            "kind": "multibuy",
            "deals": 2,
            "packsPerDeal": 3,
            "dealPrice": 905,
            "amount": 1810
          },
          {
            "kind": "unit",
            "packs": 1,
            "unitPrice": 335,
            "amount": 335
          }
        ],
        "appliedCharges": [
          {
            "label": "Beverage container deposit",
            "perPack": 10,
            "amount": 70
          }
        ],
        "disclosureCodes": [],
        "multibuy": {
          "packsPerDeal": 3,
          "dealPrice": 905,
          "mixAndMatch": false,
          "percentOff": 10,
          "deals": 2,
          "saving": 200
        }
      }
    },
    {
      "name": "a multibuy that is not cheaper is ignored",
      "offer": "dud",
      "packs": 2,
      "expect": {
        "status": "priced",
        "packsSubtotal": 600,
        "total": 600,
        "packsBreakdown": [
          {
            "kind": "unit",
            "packs": 2,
            "unitPrice": 300,
            "amount": 600
          }
        ],
        "appliedCharges": [],
        "disclosureCodes": [],
        "multibuy": null
      }
    }
  ]
}
