      "listingId": "alpha-milk",
      "productId": "milk-1l",
      "retailerId": "redmart",
      "priceKind": "ordinary",
      "unitPrice": 320,
      "eligible": true,
      "charges": [],
      "excludedPromotions": [],
      "multibuy": null
    },
    "soda": {
