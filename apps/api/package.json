{
  "name": "@cartoptix/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "seed:import": "node --env-file-if-exists=../../.env src/seed/import-cli.ts",
    "build": "tsc --build",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cartoptix/contracts": "workspace:*",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
